rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents and subcollections
    match /users/{userId} {
      allow read, write: if true;

      match /scans/{scanId} {
        allow read, write: if true;
      }

      match /impact/{impactId} {
        allow read, write: if true;
      }
    }

    match /scans/{scanId} {
      allow read, write: if true;
    }

    match /impact/{impactId} {
      allow read, write: if true;
    }
  }
}
