{
  "entities": {
    "users": {
      "title": "users",
      "description": "User profile accounts, full name, credentials and accumulated circular points",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "points": { "type": "number" },
        "savedProductsCount": { "type": "number" },
        "levelTitle": { "type": "string" },
        "co2SavedKg": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName", "email", "points"]
    },
    "scans": {
      "title": "scans",
      "description": "Scanned product history per user, analysis results and circular scores",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productName": { "type": "string" },
        "material": { "type": "string" },
        "circularScore": { "type": "number" },
        "scoreLabel": { "type": "string" },
        "environmentalImpact": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productName", "circularScore"]
    },
    "impact": {
      "title": "impact",
      "description": "Adopted sustainability decisions, actions, and environmental savings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "actionType": { "type": "string" },
        "pathwayTitle": { "type": "string" },
        "pointsGained": { "type": "number" },
        "co2SavedKg": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "actionType", "pointsGained"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User profile document"
    },
    "/users/{userId}/scans/{scanId}": {
      "schema": { "$ref": "#/entities/scans" },
      "description": "Scans subcollection for user"
    },
    "/users/{userId}/impact/{impactId}": {
      "schema": { "$ref": "#/entities/impact" },
      "description": "Impact actions subcollection for user"
    }
  }
}
